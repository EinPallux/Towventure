# Towventure environment (copy to .env for local dev; never commit .env).
# See docs/OPERATIONS.md §2.

# Postgres connection string. Local dev via docker-compose uses the value below.
DATABASE_URL=postgres://towventure:towventure@localhost:5432/towventure

# Signs the httpOnly session cookie. Generate: `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-64-char-hex-string-in-real-deployments-please-ok

# Public origin the client is served from (used for cookie + CORS-free checks).
PUBLIC_ORIGIN=http://localhost:5173

# node env: development | production | test
NODE_ENV=development

# pino level: trace | debug | info | warn | error
LOG_LEVEL=info

# Server bind.
HOST=0.0.0.0
PORT=8080

# Seasonal Honor scope (staging overrides to isolate ladders). Optional.
# HONOR_SEASON=1

# ── docker-compose only (OPERATIONS §1) ─────────────────────────────────────
# Postgres credentials for the composed cluster (host port stays closed).
POSTGRES_USER=towventure
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=towventure

# Caddy site address: your domain (auto-TLS) in prod, ":80" locally.
SITE_ADDRESS=:80

# Off-box backup target for rclone (e.g. b2:towventure-backups). Empty = local only.
RCLONE_REMOTE=

